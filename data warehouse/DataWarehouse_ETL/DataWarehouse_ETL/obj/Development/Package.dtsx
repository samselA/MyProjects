    <DTS:Executable
      DTS:refId="Package\load_dim_year"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B017227A-2D49-4D3D-AE4D-47A1510171F7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load_dim_year"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{69EDBD92-F7F4-4BFB-82F7-B6FFDFFE9D4F}"
          SQLTask:SqlStatementSource="DECLARE @StartYear int = ?; &#xA;DECLARE @EndYear   int = ?;&#xA;&#xA;;WITH Years AS (&#xA;    SELECT @StartYear AS y&#xA;    UNION ALL&#xA;    SELECT y + 1&#xA;    FROM   Years&#xA;    WHERE  y + 1 &lt;= @EndYear&#xA;)&#xA;MERGE dbo.dim_year               AS tgt&#xA;USING Years                      AS src&#xA;      ON  tgt.year_key = src.y&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (year_key,&#xA;            year_name,&#xA;            is_leap_year,&#xA;            decade,&#xA;            is_current_year,&#xA;            previous_year,&#xA;            next_year)&#xA;    VALUES ( src.y,&#xA;             'Rok ' + CAST(src.y AS varchar(4)),&#xA;             CASE WHEN (src.y % 400 = 0) OR (src.y % 4 = 0 AND src.y % 100 &lt;&gt; 0) THEN 1 ELSE 0 END,&#xA;             (src.y / 10),&#xA;             CASE WHEN src.y = YEAR(GETDATE()) THEN 1 ELSE 0 END,&#xA;             CASE WHEN src.y - 1 &gt;= @StartYear THEN src.y - 1 END,&#xA;             CASE WHEN src.y + 1 &lt;= @EndYear   THEN src.y + 1 END)&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET&#xA;        tgt.year_name       = 'Rok ' + CAST(src.y AS varchar(4)),&#xA;        tgt.is_leap_year    = CASE WHEN (src.y % 400 = 0) OR (src.y % 4 = 0 AND src.y % 100 &lt;&gt; 0) THEN 1 ELSE 0 END,&#xA;        tgt.decade          = (src.y / 10),&#xA;        tgt.is_current_year = CASE WHEN src.y = YEAR(GETDATE()) THEN 1 ELSE 0 END,&#xA;        tgt.previous_year   = CASE WHEN src.y - 1 &gt;= @StartYear THEN src.y - 1 END,&#xA;        tgt.next_year       = CASE WHEN src.y + 1 &lt;= @EndYear   THEN src.y + 1 END&#xA;OPTION (MAXRECURSION 0);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::StartYear"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::EndYear"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\sqltask_upsert_dim_country"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5EF222A0-E231-435C-8943-949DD984D6AC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sqltask_upsert_dim_country"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{69EDBD92-F7F4-4BFB-82F7-B6FFDFFE9D4F}"
          SQLTask:SqlStatementSource="DECLARE @LoadYear   smallint = ?;&#xA;DECLARE @NextYear   smallint = @LoadYear + 1;&#xA;&#xA;BEGIN TRAN;&#xA;&#xA;UPDATE T&#xA;SET    valid_to_year = @LoadYear,&#xA;       is_current    = 0&#xA;FROM   dbo.dim_country AS T&#xA;JOIN   dbo.staging_country AS S&#xA;  ON   T.iso3_code = S.iso3&#xA; AND   T.is_current = 1&#xA;WHERE  ISNULL(T.country_name       ,'') &lt;&gt; ISNULL(S.country           ,'')&#xA;    OR ISNULL(T.region_code        ,'') &lt;&gt; ISNULL(S.region            ,'')&#xA;    OR ISNULL(T.region_name        ,'') &lt;&gt; ISNULL(S.region_name       ,'')&#xA;    OR ISNULL(T.country_description,'') &lt;&gt; ISNULL(S.country_description,'');&#xA;&#xA;INSERT INTO dbo.dim_country&#xA;  ( iso3_code, country_name, region_code, region_name,&#xA;    country_description, valid_from_year, valid_to_year, is_current )&#xA;SELECT &#xA;    S.iso3,&#xA;    S.country,&#xA;    S.region,&#xA;    S.region_name,&#xA;    S.country_description,&#xA;    @NextYear,&#xA;    9999,&#xA;    1&#xA;FROM   dbo.staging_country AS S&#xA;LEFT JOIN dbo.dim_country AS T&#xA;  ON   T.iso3_code  = S.iso3&#xA; AND   T.is_current = 1&#xA;WHERE  T.iso3_code IS NULL&#xA;   OR ( &#xA;       EXISTS (&#xA;         SELECT 1 &#xA;         FROM dbo.dim_country AS T2&#xA;         WHERE T2.iso3_code    = S.iso3&#xA;           AND T2.valid_to_year = @LoadYear &#xA;           AND T2.is_current   = 0&#xA;       )&#xA;     );&#xA;&#xA;COMMIT;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::LoadYear"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
