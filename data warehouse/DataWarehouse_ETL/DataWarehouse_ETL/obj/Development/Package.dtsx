    <DTS:Executable
      DTS:refId="Package\upsert_fact_economic"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{874A2A16-0EA6-493C-9BAD-1FEA56FDEBB3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="upsert_fact_economic"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{69EDBD92-F7F4-4BFB-82F7-B6FFDFFE9D4F}"
          SQLTask:SqlStatementSource="MERGE INTO dbo.f_economic AS target&#xA;USING dbo.PreLoadEconomic AS src&#xA;   ON target.country_key = src.country_key&#xA;  AND target.date_key    = src.date_key&#xA;&#xA;WHEN MATCHED THEN&#xA;    UPDATE&#xA;       SET &#xA;         target.gdp_per_capita       = src.gdp_per_capita,&#xA;         target.gini_index           = src.gini_index,&#xA;         target.unemployment_rate    = src.unemployment_rate,&#xA;         target.co2_emissions_pc     = src.co2_emissions_per_capita,&#xA;         target.renewable_energy_pct = src.renewable_energy_pct,&#xA;         target.govt_expenditure_pct = src.govt_educ_expenditure_pct,&#xA;         target.health_exp_per_capita = src.health_exp_per_capita,&#xA;         target.internet_users_pc    = src.internet_users_pct,&#xA;         target.gni_ppp              = src.gni_ppp,&#xA;         target.loaded_at            = src.loaded_at&#xA;&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (&#xA;       country_key,&#xA;       date_key,&#xA;       gdp_per_capita,&#xA;       gini_index,&#xA;       unemployment_rate,&#xA;       co2_emissions_pc,&#xA;       renewable_energy_pct,&#xA;       govt_expenditure_pct,&#xA;       health_exp_per_capita,&#xA;       internet_users_pc,&#xA;       gni_ppp,&#xA;       loaded_at&#xA;    )&#xA;    VALUES (&#xA;       src.country_key,&#xA;       src.date_key,&#xA;       src.gdp_per_capita,&#xA;       src.gini_index,&#xA;       src.unemployment_rate,&#xA;       src.co2_emissions_per_capita,&#xA;       src.renewable_energy_pct,&#xA;       src.govt_educ_expenditure_pct,&#xA;       src.health_exp_per_capita,&#xA;       src.internet_users_pct,&#xA;       src.gni_ppp,&#xA;       src.loaded_at&#xA;    );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\upsert_fact_happiness"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E5F5DD36-D1CB-4319-B05A-19F69E7D8A96}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="upsert_fact_happiness"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{69EDBD92-F7F4-4BFB-82F7-B6FFDFFE9D4F}"
          SQLTask:SqlStatementSource="MERGE INTO dbo.f_happiness AS target&#xA;USING dbo.PreLoadHappiness AS src&#xA;   ON target.country_key = src.country_key&#xA;  AND target.date_key    = src.date_key&#xA;&#xA;WHEN MATCHED THEN&#xA;    UPDATE&#xA;       SET &#xA;         target.ladder_score      = CASE &#xA;                                       WHEN src.ladder_score IS NOT NULL &#xA;                                       THEN src.ladder_score &#xA;                                       ELSE target.ladder_score &#xA;                                     END,&#xA;         target.gdp_log           = CASE &#xA;                                       WHEN src.gdp_log IS NOT NULL &#xA;                                       THEN src.gdp_log &#xA;                                       ELSE target.gdp_log &#xA;                                     END,&#xA;         target.social_support    = CASE &#xA;                                       WHEN src.social_support IS NOT NULL &#xA;                                       THEN src.social_support &#xA;                                       ELSE target.social_support &#xA;                                     END,&#xA;         target.health_expectancy = CASE &#xA;                                       WHEN src.health_expectancy IS NOT NULL &#xA;                                       THEN src.health_expectancy &#xA;                                       ELSE target.health_expectancy &#xA;                                     END,&#xA;         target.freedom           = CASE &#xA;                                       WHEN src.freedom IS NOT NULL &#xA;                                       THEN src.freedom &#xA;                                       ELSE target.freedom &#xA;                                     END,&#xA;         target.generosity        = CASE &#xA;                                       WHEN src.generosity IS NOT NULL &#xA;                                       THEN src.generosity &#xA;                                       ELSE target.generosity &#xA;                                     END,&#xA;         target.corruption        = CASE &#xA;                                       WHEN src.corruption IS NOT NULL &#xA;                                       THEN src.corruption &#xA;                                       ELSE target.corruption &#xA;                                     END,&#xA;         -- Zawsze nadpisujemy timestamp&#xA;         target.loaded_at         = src.loaded_at&#xA;&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (&#xA;       country_key,&#xA;       date_key,&#xA;       ladder_score,&#xA;       gdp_log,&#xA;       social_support,&#xA;       health_expectancy,&#xA;       freedom,&#xA;       generosity,&#xA;       corruption,&#xA;       loaded_at&#xA;    )&#xA;    VALUES (&#xA;       src.country_key,&#xA;       src.date_key,&#xA;       src.ladder_score,&#xA;       src.gdp_log,&#xA;       src.social_support,&#xA;       src.health_expectancy,&#xA;       src.freedom,&#xA;       src.generosity,&#xA;       src.corruption,&#xA;       src.loaded_at&#xA;    );&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\upsert_fact_hdi"
