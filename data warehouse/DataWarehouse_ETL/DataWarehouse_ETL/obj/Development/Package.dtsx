      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{69EDBD92-F7F4-4BFB-82F7-B6FFDFFE9D4F}"
          SQLTask:SqlStatementSource="MERGE INTO dbo.f_hdi AS target&#xA;USING dbo.PreLoadHDI AS src&#xA;   ON target.country_key = src.country_key&#xA;  AND target.date_key    = src.date_key&#xA;&#xA;WHEN MATCHED THEN&#xA;    UPDATE&#xA;       SET &#xA;         target.hdi             = src.hdi,&#xA;         target.life_exp_idx    = src.life_exp_idx,&#xA;         target.edu_idx         = src.edu_idx,&#xA;         target.gni_idx         = src.gni_idx,&#xA;         target.population      = src.population,&#xA;         target.loaded_at       = src.loaded_at&#xA;&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (&#xA;       country_key,&#xA;       date_key,&#xA;       hdi,&#xA;       life_exp_idx,&#xA;       edu_idx,&#xA;       gni_idx,&#xA;       population,&#xA;       loaded_at&#xA;    )&#xA;    VALUES (&#xA;       src.country_key,&#xA;       src.date_key,&#xA;       src.hdi,&#xA;       src.life_exp_idx,&#xA;       src.edu_idx,&#xA;       src.gni_idx,&#xA;       src.population,&#xA;       src.loaded_at&#xA;    );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
